diff --git a/lib/crypto.h b/lib/crypto.h
--- a/lib/crypto.h
+++ b/lib/crypto.h
@@ -83,6 +83,14 @@ int gcm_decrypt(unsigned char *ciphertext, int ciphertext_len, unsigned char *pl
 
 typedef struct ed25519_key_s ed25519_key_t;
 
+/* ParkCast (KEYCHECK stage, AIR-048): with a keyfile, an existing file is only ever read, never rewritten;
+ * a missing file is created once (O_EXCL, mode 0600). On failure the result is NULL and *result is one of
+ * these codes (raop.h repeats them as RAOP_KEY_ERR_*). *result is 1 when a new key was stored, else 0. */
+#define ED25519_KEY_ERR_READ      -2   /* the keyfile exists but cannot be opened for reading */
+#define ED25519_KEY_ERR_PARSE     -3   /* the keyfile holds no Ed25519 private key in PEM */
+#define ED25519_KEY_ERR_CREATE    -4   /* the keyfile is missing and cannot be created */
+#define ED25519_KEY_ERR_WRITE     -5   /* the new keyfile could not be written; it is removed again */
+#define ED25519_KEY_ERR_GENERATE  -6   /* key generation failed */
 ed25519_key_t *ed25519_key_generate(const char *device_id, const char * keyfile, int * result);
 ed25519_key_t *ed25519_key_from_raw(const unsigned char data[ED25519_KEY_SIZE]);
 void ed25519_key_get_raw(unsigned char data[ED25519_KEY_SIZE], const ed25519_key_t *key);
