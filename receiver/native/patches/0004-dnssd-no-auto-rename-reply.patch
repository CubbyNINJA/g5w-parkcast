diff --git a/lib/dnssd.h b/lib/dnssd.h
--- a/lib/dnssd.h
+++ b/lib/dnssd.h
@@ -86,6 +86,14 @@ DNSSD_API void dnssd_set_pk(dnssd_t *dnssd, char * pk_str);
 DNSSD_API int dnssd_get_service_fd(dnssd_t *dnssd, int service);
 DNSSD_API int dnssd_process_service(dnssd_t *dnssd, int service);
 
+/* ParkCast (ADVERTISE stage, AIR-050): the registrations use kDNSServiceFlagsNoAutoRename, so a name
+   conflict comes back as an error instead of a silent rename. The daemon's verdict arrives later, through
+   dnssd_process_service(); set this callback to receive it as (cls, DNSSD_SERVICE_*, errorCode). errorCode
+   is 0 once the name is registered, or a negative dns_sd.h code (-65548 is a name conflict). NULL is
+   allowed: the reply is then dropped, as before. */
+typedef void (*dnssd_register_reply_t)(void *cls, int service, int error_code);
+DNSSD_API void dnssd_set_register_callback(dnssd_t *dnssd, dnssd_register_reply_t callback, void *cls);
+
 DNSSD_API void dnssd_destroy(dnssd_t *dnssd);
 
