@@ -27,6 +27,8 @@
 #include "../utils.h"
 
 #define MAX_DEVICEID 18
+/* ParkCast: kDNSServiceFlagsNoAutoRename from Apple's dns_sd.h (an enum there, so not tested with #ifdef) */
+#define PARKCAST_FLAG_NO_AUTO_RENAME 0x8
 #define MAX_SERVNAME 256
 
 #if defined(HAVE_LIBDL) && !defined(__APPLE__)
@@ -130,14 +132,24 @@ typedef struct dnssd_private_s {
     DNSServiceRef raop_service;
     DNSServiceRef airplay_service;
 
+    dnssd_register_reply_t register_reply;   /* ParkCast: may be NULL */
+    void *register_reply_cls;
 } dnssd_private_t;
 
 /* --- Dummy Callback to prevent Avahi/DBus from leaking OutgoingBytes --- */
+/* ParkCast: no longer a dummy. context is the dnssd_private_t; the reply code goes to the register_reply
+   callback, if one is set, tagged with the service it belongs to. */
 static void DNSSD_STDCALL 
 dnssd_register_dummy_callback(DNSServiceRef sdRef, DNSServiceFlags flags, DNSServiceErrorType errorCode,
                               const char *name, const char *regtype, const char *domain, void *context) 
 {
-    (void)sdRef; (void)flags; (void)errorCode; (void)name; (void)regtype; (void)domain; (void)context;
+    (void)flags; (void)name; (void)regtype; (void)domain;
+    dnssd_private_t *dnssd = (dnssd_private_t *) context;
+    if (!dnssd || !dnssd->register_reply) {
+        return;
+    }
+    int service = (sdRef == dnssd->airplay_service) ? DNSSD_SERVICE_AIRPLAY : DNSSD_SERVICE_RAOP;
+    dnssd->register_reply(dnssd->register_reply_cls, service, (int) errorCode);
 }
 
