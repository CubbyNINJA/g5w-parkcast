+/* ParkCast: see dnssd.h */
+void
+dnssd_set_register_callback(dnssd_t *dnssd_public, dnssd_register_reply_t callback, void *cls)
+{
+    assert(dnssd_public);
+    assert(dnssd_public->dnssd_private);
+    dnssd_private_t *dnssd = (dnssd_private_t *) dnssd_public->dnssd_private;
+    dnssd->register_reply = callback;
+    dnssd->register_reply_cls = cls;
+}
